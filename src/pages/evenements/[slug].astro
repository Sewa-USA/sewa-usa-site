---
import Base from '../../layouts/Base.astro';
import { getEvents, formatDateTime, img } from '../../lib/content';

export async function getStaticPaths() {
  return (await getEvents()).map((event) => ({ params: { slug: event.slug }, props: { event } }));
}

const { event } = Astro.props;
---

<Base title={event.title} description={event.summary}>
  <div class="page-head">
    <div class="wrap enter">
      <a href="/evenements">← Tous les événements</a>
      <p class="meta" style="margin-top:1rem">
        {event.sample && <span class="badge badge--sample">Exemple</span>}
        {formatDateTime(event.date)}
      </p>
      <h1>{event.title}</h1>
      <p class="lead">{event.location}</p>
    </div>
  </div>
  <section class="section">
    <div class="wrap prose reveal">
      {event.imageUrl && <img class="cover" src={img(event.imageUrl, 1100, 620)} alt="" width="1100" height="620" loading="lazy" />}
      <p><strong>{event.summary}</strong></p>
      {event.body.map((p) => <p>{p}</p>)}
      {new Date(event.date) >= new Date() && (
        <a class="btn btn--outline ics-link" href={`/evenements/${event.slug}.ics`}>Ajouter à mon calendrier</a>
      )}
    </div>
  </section>
</Base>
