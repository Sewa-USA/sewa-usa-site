---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/content';

const posts = getPosts();
---

<Base title="Actualités" description="Actualités et communiqués officiels de SEWA USA.">
  <div class="page-head">
    <div class="wrap">
      <span class="eyebrow">Actualités</span>
      <h1>Les nouvelles de la communauté</h1>
      <p class="lead">Annonces, comptes rendus et communiqués officiels de l'association.</p>
    </div>
  </div>
  <section class="section">
    <div class="wrap">
      {posts.length ? (
        <div class="grid grid--3">{posts.map((p) => <PostCard post={p} />)}</div>
      ) : (
        <div class="empty">Aucune actualité pour le moment.</div>
      )}
    </div>
  </section>
</Base>
